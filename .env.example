# Copy this file to .env and fill in real values. Never commit .env itself.

# Embedding model (sentence-transformers, runs locally — no key needed by default)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: if you swap the local embedder for an API-based one later
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: Groq (used by src/pregnancysafe/llm/groq_composer.py for LLM-generated
# answers instead of the default template composer). Get a free key at
# https://console.groq.com/keys — paste it here in your LOCAL .env only,
# never in chat/prompts. This file (.env) is already excluded via .gitignore.
GROQ_API_KEY=

# Vector store location (overrides config.yaml if set)
VECTORSTORE_DIR=data/vectorstore

# Logging
LOG_LEVEL=INFO
